def lcs(str1, str2):
    m = len(str1)
    n = len(str2)

    # Create DP table
    dp = [[0] * (n + 1) for _ in range(m + 1)]

    # Fill DP table
    for i in range(1, m + 1):
        for j in range(1, n + 1):
            if str1[i - 1] == str2[j - 1]:
                dp[i][j] = dp[i - 1][j - 1] + 1
            else:
                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])

    # Find the LCS string
    i = m
    j = n
    lcs_string = ""

    while i > 0 and j > 0:
        if str1[i - 1] == str2[j - 1]:
            lcs_string = str1[i - 1] + lcs_string
            i -= 1
            j -= 1
        elif dp[i - 1][j] > dp[i][j - 1]:
            i -= 1
        else:
            j -= 1

    return lcs_string, dp[m][n]


# Main Program
string1 = input("Enter first string: ")
string2 = input("Enter second string: ")

answer, length = lcs(string1, string2)

print("Longest Common Subsequence:", answer)
print("Length:", length)


